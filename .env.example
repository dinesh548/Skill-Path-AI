# SkillPath AI Environment Configuration

# Database Configuration
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# For SQLite (default zero-config local run): sqlite:///./skillpath.db
DATABASE_URL=sqlite:///./skillpath.db

# Random Seed for Reproducibility
RANDOM_SEED=20261022

# Dataset Configuration (STARTER or FULL)
# Starter: 150 employees, 60 skills, 100 courses, 350 enrollments
# Full: 5,000 employees, 500 skills, 1,000 courses, 10,000 enrollments
DATASET_MODE=STARTER

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000/api
